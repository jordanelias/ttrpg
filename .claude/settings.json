{
  "permissions": {
    "deny": [
      "mcp__Claude_Code_Remote__send_later",
      "mcp__claude-code-remote__send_later",
      "mcp__claude_code_remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude_code_remote__create_trigger",
      "ScheduleWakeup",
      "CronCreate"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python tools/hook_naming_guard.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python tools/session_status.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python tools/session_handoff_reminder.py" }
        ]
      }
    ]
  }
}

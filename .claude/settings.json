{
  "permissions": {
    "deny": [
      "mcp__Claude_Code_Remote__send_later",
      "mcp__claude-code-remote__send_later",
      "mcp__claude_code_remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude_code_remote__create_trigger",
      "ScheduleWakeup",
      "CronCreate",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude_code_remote__update_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__claude-code-remote__fire_trigger",
      "mcp__claude_code_remote__fire_trigger",
      "Skill(loop)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(python tools/*)",
      "Bash(python3 tools/*)",
      "Bash(python -m pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hook_naming_guard.py"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hook_md_sweep_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [],
    "Stop": []
  }
}

# Shell hooks must stay LF so the #!/bin/sh interpreter line works on every platform.
.githooks/** text eol=lf
*.sh text eol=lf

# Generated season-loop run output (engine/season/runs/). Only results.json is TRACKED (REM-46 untracked
# TRACE.txt and the eight markdown logs): it is the byte-for-byte golden
# `test_w15_report_py_reproduces_every_committed_artifact_byte_for_byte` compares against, and
# `harness/delta.py` reads it. `-diff` keeps it out of `git diff`/`git log -p` (and so out of every
# agent that reads a diff); the bytes are unchanged.
engine/season/runs/** -diff linguist-generated=true
